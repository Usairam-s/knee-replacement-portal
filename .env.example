# ==========================================
# PostOp-Check Environment Configuration
# Copy these values into your Vercel Project Environment Variables
# ==========================================

# 1. Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# 2. Neon PostgreSQL Database
DATABASE_URL=postgresql://...

# 3. Orthopedic Machine Learning API Endpoint (PythonAnywhere WSGI)
NEXT_PUBLIC_ML_API_URL=https://yousairam.pythonanywhere.com/predict-risk

# 4. OpenAI Clinical Recovery Brief Synthesis (GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...
